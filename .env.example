# Example .env file for Schnitzeljagd
# Copy this file to .env and update with your values

# API Configuration
API_BASE_URL=https://your-api-server.com
API_KEY=your-api-key-here

# Map Configuration (Hannover, Germany)
DEFAULT_LATITUDE=52.3759
DEFAULT_LONGITUDE=9.7320
DEFAULT_ZOOM=13

# Photo Settings
PHOTO_STORAGE_DIR=photos
PHOTO_QUALITY=85

# Location Settings
PROXIMITY_THRESHOLD=50
GPS_UPDATE_INTERVAL=5
